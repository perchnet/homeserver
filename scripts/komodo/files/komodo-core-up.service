[Unit]
Description=Bring up the Komodo Core service with docker compose
After=docker.service
Requires=docker.service
ConditionPathExists=!/etc/komodo/core/started

[Service]
Type=oneshot
Restart=on-failure
StandardOutput=journal
StandardError=journal
EnvironmentFile=/usr/share/komodo/default.env
WorkingDirectory=${KOMODO_DEFAULT_CONFIG_DIR_CORE}
ExecStart=/usr/bin/docker compose -p komodo -f compose.yml -f compose.override.yml --env-file ${KOMODO_CORE_ENV_FILE} up -d
ExecStartPost=/usr/bin/touch /etc/komodo/core/started

[Install]
WantedBy=multi-user.target